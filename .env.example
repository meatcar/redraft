# Copy to .env (direnv loads it) or set in the environment. All optional except LLM_BASE_URL for suggestions.
PORT=3000
# Any OpenAI-compatible endpoint, including the /v1 suffix.
LLM_BASE_URL=https://cpa.pvlv.ca/v1
# Optional server-side key. The key entered in the UI takes precedence.
LLM_API_KEY=
# Default model id; the UI can override it per request.
LLM_MODEL=
# Set false for endpoints that reject response_format json_schema.
LLM_STRUCTURED_OUTPUTS=true
# Max model steps per suggestion, including context-search tool calls.
LLM_MAX_STEPS=6
# Context folders must resolve inside this directory. Defaults to $HOME.
CONTEXT_ROOT=
# Context folder used when the UI leaves the field empty.
CONTEXT_DIR=
